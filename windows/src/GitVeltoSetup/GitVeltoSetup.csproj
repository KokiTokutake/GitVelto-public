<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GitVeltoSetup.exe: single-file installer. Self-contained, trimmed and compressed, so it runs without the
    .NET runtime (it then checks for the runtime GitVelto itself needs). The built app (windows\out\GitVelto)
    is embedded as payload.zip; windows\build.ps1 -Setup creates it before publishing this project.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GitVelto.Setup</RootNamespace>
    <AssemblyName>GitVeltoSetup</AssemblyName>
    <SelfContained>true</SelfContained>
    <!-- Bundled runtime: 10.0.14 or later (10.0.0-10.0.13 are affected by CVE-2026-111497 / GHSA-p3jp-9v83-76w9). -->
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
    <ApplicationIcon>..\GitVelto\Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)')" />
  </ItemGroup>
</Project>
